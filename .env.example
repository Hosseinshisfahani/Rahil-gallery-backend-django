# Django — Rahil Gallery (Strangler Fig sibling of Go API)
# Share DATABASE_URL and JWT_ACCESS_SECRET with Rahil-gallery-backend-go.

DJANGO_SECRET_KEY=change-me-django-secret-not-for-jwt
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Same Postgres as Go (golang-migrate owns identity/catalog/CRM schema)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/rahil_gallery?sslmode=disable

# Same HS256 secret Go uses to issue access tokens (NOT DJANGO_SECRET_KEY)
JWT_ACCESS_SECRET=change-me-min-32-chars-shared-with-go

# Bind (default matches Next.js DJANGO_API_PROXY_URL)
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000
